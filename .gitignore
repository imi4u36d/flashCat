# Build output
build/
dist/
native/.build/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate
*.log

# Local-only data
__pycache__/
*.pyc

# Agent workspace memory (local notes, not project code)
.workbuddy/

# OS metadata
.DS_Store

# Editor workspace settings
.vscode/

# Internal docs (visual spec, implementation notes, screenshots)
docs/

# Engine runtime packs (GB-scale build output; install via scripts/engines)
vendor/engines/

# Downloaded release tarballs (build inputs; the app can fetch them)
vendor/*.tar.gz

# Bootstrap-cached tools (standalone uv downloaded by the engine pack scripts)
.tools/
