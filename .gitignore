# Build output
build/
dist/
native/.build/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate
*.log

# Local-only data
__pycache__/
*.pyc

# Agent workspace memory (local notes, not project code)
.workbuddy/

# OS metadata
.DS_Store

# Editor workspace settings
.vscode/

# Internal scratch (screenshots, one-off notes). Design docs under docs/reviews
# and docs/specs ARE tracked: an open-source project's specs are an asset.
docs/scratch/
*.screenshot.png

# Engine runtime packs (GB-scale build output; install via scripts/engines)
vendor/engines/

# Downloaded release tarballs + checksums (build inputs; the app can fetch them)
vendor/*.tar.gz
vendor/*.sha256

# Bootstrap-cached tools (standalone uv downloaded by the engine pack scripts)
.tools/
