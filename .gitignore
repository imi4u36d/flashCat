# Build output
build/
dist/
native/.build/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate
*.log

# Local-only data
__pycache__/
*.pyc

# OS metadata
.DS_Store

# Internal docs (visual spec, implementation notes, screenshots)
docs/

# Engine runtime packs (GB-scale build output; install via scripts/engines)
vendor/engines/

# Downloaded release tarballs (build inputs; the app can fetch them)
vendor/*.tar.gz
