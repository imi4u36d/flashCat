# Build output
build/
dist/
native/.build/
.build/
# SwiftPM scratch dirs created by editor/LSP builds (--scratch-path .build-sc)
.build-sc/
.swiftpm/
xcuserdata/
*.xcuserstate
*.log

# Local-only data
__pycache__/
*.pyc

# Agent workspace memory (local notes, not project code)
.workbuddy/

# OS metadata
.DS_Store

# Editor workspace settings
.vscode/

# Internal scratch (screenshots, one-off notes, local builds and .bak files).
# Design docs under docs/reviews and docs/specs ARE tracked: an open-source
# project's specs are an asset.
.scratch/
docs/scratch/
*.screenshot.png

# locally and shipped outside the repo. 5d14e3d removed an accidental add.
promo/

# Engine runtime packs (GB-scale build output; install via scripts/engines)
vendor/engines/

# Downloaded release tarballs + checksums (build inputs; the app can fetch them)
vendor/*.tar.gz
vendor/*.sha256

# Bootstrap-cached tools (standalone uv downloaded by the engine pack scripts)
.tools/


# 编辑器/工具本地状态
.zcode/

# pnpm 的内容寻址仓库（前端工具链的本地缓存，166 MB / 2300+ 文件）
# c686b0a 那次 revert 把它误提交了进来，这个条目防止再犯。
.pnpm-store/
node_modules/
