{
  "name": "flashcat",
  "private": true,
  "type": "module",
  "description": "flashCat — 本地多引擎推理的 macOS 应用。本 package 仅管理 WebUI 的打包工具链（esbuild），运行时零 npm 依赖。",
  "scripts": {
    "build:webui": "esbuild native/Sources/FlashCat/WebUI/main.js --bundle --format=iife --target=es2022 --charset=utf8 --outfile=native/Sources/FlashCat/WebUI/bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
